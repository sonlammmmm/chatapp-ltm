# Copy to .env and supply the SAME Base64 32-byte key on server and clients.
# Keep the existing key when encrypted history already exists.
CHATAPP_TEXT_KEY=

# Server address prefilled in the client (use the server LAN IP on other machines).
CHATAPP_SERVER_HOST=127.0.0.1
# Default port shown on both client and server. Allowed: 1024..65535.
CHATAPP_SERVER_PORT=8888
# Timeouts in milliseconds. Allowed: 1..300000.
CHATAPP_CONNECT_TIMEOUT_MS=10000
CHATAPP_REQUEST_TIMEOUT_MS=15000
CHATAPP_P2P_TIMEOUT_MS=30000
# Server chooses the file transport for all clients: p2p (LAN/Radmin VPN) or relay.
CHATAPP_FILE_MODE=p2p
# Server only; used in relay mode. Both clients connect OUT to this TCP port.
# Must differ from the chat port and be reachable at the same host as the chat server.
CHATAPP_FILE_RELAY_PORT=8889
# Server only. Relative to the working directory, or an absolute path.
# Changing this path selects a different database; it does not migrate existing data.
CHATAPP_DB_PATH=database/chatapp.db
